<% content_for :page_styles do %>
  <%= stylesheet_link_tag "sessions/session", "data-turbo-track": "reload" %>
<% end %>

<main class="auth-page">
  <section class="auth-card">

    <div class="auth-heading">
      <%= image_tag "audio-waveform.svg",
          class: "auth-logo",
          alt: "Listen logo" %>

      <h1>Welcome back<span class="orange-text">.</span></h1>
      <p>Log in to your Listen account.</p>
    </div>

    <%= tag.div(flash[:alert], class: "auth-alert", role: "alert") if flash[:alert] %>
    <%= tag.div(flash[:notice], class: "auth-notice", role: "status") if flash[:notice] %>

    <%= form_with url: session_path,
                  method: :post,
                  html: { class: "auth-form" } do |form| %>

      <div class="form-group">
        <%= form.label :email_address, "Email address" %>

        <%= form.email_field :email_address,
            placeholder: "you@example.com",
            autocomplete: "username",
            autofocus: true,
            required: true,
            value: params[:email_address],
            class: "auth-input" %>
      </div>

      <div class="form-group">
        <div class="password-heading">
          <%= form.label :password, "Password" %>

          <%= link_to "Forgot password?",
              new_password_path,
              class: "forgot-link" %>
        </div>

        <%= form.password_field :password,
            placeholder: "Enter your password",
            autocomplete: "current-password",
            required: true,
            maxlength: 72,
            class: "auth-input" %>
      </div>

      <%= form.submit "Log in", class: "auth-button" %>

    <% end %>

    <div class="auth-divider">
      <span>NEW TO LISTEN?</span>
    </div>

    <div class="auth-footer">
      <p>Discover your own listening space.</p>

      <%= link_to "Create an account",
          new_registration_path,
          class: "signup-button" %>
    </div>

  </section>
</main>
