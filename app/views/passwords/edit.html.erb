
<% content_for :page_styles do %>
  <%= stylesheet_link_tag "auth/password_update", "data-turbo-track": "reload" %>
<% end %>

<main class="auth-page">
  <section class="auth-card">

    <div class="auth-heading">
      <%= image_tag "audio-waveform.svg",
          class: "auth-logo",
          alt: "Listen logo" %>

      <h1>Update your password<span class="orange-text">.</span></h1>

      <p>
        Choose a new password for your Listen account.
        Make sure it's secure and easy for you to remember.
      </p>
    </div>

    <%= tag.div(flash[:alert], class: "auth-alert", role: "alert") if flash[:alert] %>
    <%= tag.div(flash[:notice], class: "auth-notice", role: "status") if flash[:notice] %>

    <%= form_with url: password_path(params[:token]),
                  method: :put,
                  html: { class: "auth-form" } do |form| %>

      <div class="form-group">
        <%= form.label :password, "New password" %>

        <%= form.password_field :password,
            required: true,
            autofocus: true,
            autocomplete: "new-password",
            placeholder: "Enter new password",
            maxlength: 72,
            class: "auth-input" %>
      </div>

      <div class="form-group">
        <%= form.label :password_confirmation, "Confirm new password" %>

        <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            placeholder: "Repeat new password",
            maxlength: 72,
            class: "auth-input" %>
      </div>

      <%= form.submit "Update password", class: "auth-button" %>

    <% end %>

  </section>
</main>
