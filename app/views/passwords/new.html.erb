<% content_for :page_styles do %>
  <%= stylesheet_link_tag "passwords/new", "data-turbo-track": "reload" %>
<% end %>

<main class="auth-page">
  <section class="auth-card password-reset-card">

    <div class="auth-heading">
      <%= image_tag "audio-waveform.svg",
          class: "auth-logo",
          alt: "Listen logo" %>

      <h1>Forgot your password<span class="orange-text">?</span></h1>

      <p>
        No worries! Enter your email address and we'll send
        you instructions to reset your password.
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="auth-alert" role="alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="auth-notice" role="status">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: passwords_path,
                  method: :post,
                  html: { class: "auth-form" } do |form| %>

      <div class="form-group">
        <%= form.label :email_address, "Email address" %>

        <%= form.email_field :email_address,
            placeholder: "you@example.com",
            autocomplete: "username",
            required: true,
            autofocus: true,
            value: params[:email_address],
            class: "auth-input" %>
      </div>

      <%= form.submit "Send reset instructions",
          class: "auth-button" %>

    <% end %>
    
  </section>
</main>
